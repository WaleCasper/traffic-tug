# ===== 複製成 .env 後修改。.env 不要上傳 GitHub =====

# 本台負責的隊伍:VM 2 填 A,VM 3 填 B
TEAM=A
HOST=0.0.0.0
PORT=8100

# 讀取哪張網卡的計數器當比分(用 ip a 查,VMware 常見為 ens33)
IFACE=ens33
# nic = 網卡實測(正式使用);app = 應用層估算(只給沒有獨立網卡的本機測試)
METRIC_SOURCE=nic

# 兩隊的公開網址(Cloudflare Tunnel),兩台 VM 的這兩行要完全一樣
PUBLIC_URL_A=https://tug-a.example.com
PUBLIC_URL_B=https://tug-b.example.com
# QR Code 指向的網址,留空則用 PUBLIC_URL_A
JOIN_URL=
# 其他允許跨網域呼叫的網址(逗號分隔),通常留空
EXTRA_ORIGINS=

# 管理密碼(開始、停止、重置、調參數)。兩台設一樣,請改成長亂碼
ADMIN_TOKEN=change-me-admin
# Zabbix 告警通知用密碼(選配)
ALERT_TOKEN=change-me-alert

# 經 Cloudflare 時用 CF-Connecting-IP 判斷來源 IP
TRUST_CF_CONNECTING_IP=true
# 每個來源 IP 每秒請求上限,0 = 不限制(同一校園網路常共用 IP,建議維持 0)
PER_IP_MAX_RPS=0

# ===== 遊戲參數(管理頁可即時調整,重啟後回到這裡的值)=====
# 拔河
TUG_DURATION=30
TUG_A_BYTES=6144
TUG_B_BYTES=16
TUG_B_BURST=4
TUG_TAPS_PER_SEC=2
# 偷鑽石
HEIST_DURATION=45
HEIST_STEP_BYTES=4096
HEIST_TAPS_PER_SEC=3
# 依人數自動調整:開始時鎖定各隊人數,每 HEIST_GROUP_SIZE 人為一級(1–5 人算 1 級)
# 門檻 = 倒數期間量到的背景流量 + HEIST_ALLOW_PER_GROUP_MBPS × 級數
# 終點 = HEIST_GOAL_PER_GROUP_MB × 級數(前進量會先扣掉背景流量)
HEIST_GROUP_SIZE=5
HEIST_ALLOW_PER_GROUP_MBPS=0.3
HEIST_GOAL_PER_GROUP_MB=1.2
HEIST_GRACE_SEC=2
# 每台 VM 的保護上限
MAX_RPS=300
MAX_MBPS=4.5
